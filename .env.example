# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NVD (opcional). Sin API key el limite es 5 solicitudes/30s (suficiente para 8 fabricantes).
# Con API key gratuita (https://nvd.nist.gov/developers/request-an-api-key) sube a 50/30s.
NVD_API_KEY=

# Dias hacia atras a revisar en cada ejecucion (con margen de solape por si una ejecucion falla)
LOOKBACK_DAYS=3
